<mujoco model="siminspect_scene">

    <compiler angle="degree"/>
    <option gravity="0 0 -9.81"/>

    <default>
        <geom density="300" friction="1 0.005 0.0001" condim="3"/>
    </default>

    <worldbody>
        <!-- Light -->
        <light name="main_light" pos="0 0 4" dir="0 0 -1"/>

        <!-- Camera -->
        <camera
            name="inspection_camera"
            pos="0 -3 2"
            xyaxes="1 0 0 0 0.5 1"/>

        <!-- Floor -->
        <geom
            name="floor"
            type="plane"
            size="5 5 0.1"
            rgba="0.8 0.8 0.8 1"/>

        <!-- Conveyor/platform -->
        <body name="conveyor" pos="0 0 0.1">
            <geom
                name="conveyor_belt"
                type="box"
                size="1.5 0.5 0.05"
                rgba="0.2 0.2 0.2 1"/>
        </body>

        <!-- Red apple -->
        <body name="red_apple" pos="-0.5 0 0.35">
            <freejoint name="red_apple_joint"/>
            <geom
                name="red_apple_geom"
                type="sphere"
                size="0.10"
                rgba="1 0 0 1"/>
        </body>

        <!-- Green box -->
        <body name="green_box" pos="0 0 0.35">
            <freejoint name="green_box_joint"/>
            <geom
                name="green_box_geom"
                type="box"
                size="0.11 0.11 0.11"
                rgba="0 1 0 1"/>
        </body>

        <!-- Blue fish -->
        <body name="blue_fish" pos="0.5 0 0.35">
            <freejoint name="blue_fish_joint"/>
            <geom
                name="blue_fish_geom"
                type="ellipsoid"
                size="0.18 0.07 0.05"
                rgba="0 0.2 1 1"/>
        </body>
    </worldbody>

</mujoco>